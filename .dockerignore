# Docker build context exclusions.
# CRITICAL: .env is excluded from git but NOT filtered by it — without this
# file, `docker build` copies it (and any API keys it holds) into image layers.
.env
.env.*
.git
.gitignore
node_modules
output
.output.*
chroma_data
.pages
.claude
*.log
.DS_Store

# Recoverable publication state and private local orchestration receipts
.*.publication-*
.*.previous-*
.pages-build-*
.seed-build-*
.manuscript-build-*
