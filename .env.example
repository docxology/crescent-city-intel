# Copy to .env and fill in real values. .env is gitignored — never commit real keys.

# --- Provider and local services ---
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text
# CHAT_MODEL=gemma3:4b
# CHROMA_URL=http://localhost:8001
# PORT=3000
# LOG_LEVEL=info
# SOURCE_FETCH_TIMEOUT_MS=10000
# NEWS_FETCH_TIMEOUT_MS=10000
# NEWS_DISABLED_SOURCES=   # comma-separated feed names to mark unavailable without fetching
# GOV_MEETINGS_TIMEOUT_MS=10000
# YT_DLP_TIMEOUT_MS=15000
# CURATION_SUMMARY_TIMEOUT_MS=15000
# HEADLESS_BROWSER=1       # run the Playwright scraper headless (required for CI/Docker)

# --- OpenRouter (optional — alternative to local Ollama for chat/curation) ---
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
# OPENROUTER_MAX_TOKENS=1024
# OPENROUTER_MAX_REQUESTS=100
# OPENROUTER_TIMEOUT_MS=120000
# LLM_PREFLIGHT_TIMEOUT_MS=5000
# OPENROUTER_MIN_REQUEST_INTERVAL_MS=3100

# --- RAG tuning (optional) ---
# RERANK_ENABLED=false    # enable lexical-hybrid post-retrieval rerank
# RERANK_TOP_N=5          # chunks retained when RERANK_ENABLED=true

# --- API security ---
# CRESCENT_CITY_API_KEY=  # valid key for /api/* endpoints (random per boot when unset)

# --- Alert webhook (optional) ---
# ALERT_WEBHOOK_URL=      # POSTed on composite WARNING/EMERGENCY (fire-and-forget)
# ALERT_WEBHOOK_TIMEOUT_MS=5000

# --- Source discovery (optional) ---
# SOURCE_DISCOVERY_TIMEOUT_MS=10000
# SOURCE_DISCOVERY_LIVE_CHECK=1   # probe discovery-only sources (scheduled runs only)

# --- Air quality alerts (optional) ---
# AIRNOW_API_KEY=...

# --- LifeOS / Pulse bridge (optional) ---
# LIFEOS_DATA_DIR=...
# LIFEOS_CUSTOMIZATIONS_DIR=...

# --- Pages build (optional) ---
# PAGES_BUILD=1
# PAGES_OUTPUT_DIR=.pages
# PAGES_SEED_DIR=pages-data

# --- Advanced ---
# OUTPUT_DIR=output
# APP_VERSION=2.5.1
